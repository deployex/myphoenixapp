#!/bin/sh

# Only enabled when the mTLS cert bundle is actually present. A caller that
# boots this release without it - e.g. relup-guard-elixir, which has no
# certs and sets its own name/IP-based node for an isolated CI run - would
# otherwise have its distribution settings clobbered below and fail to boot.
if [ -f /tmp/inet_tls.conf ]; then
  export ELIXIR_ERL_OPTIONS="-proto_dist inet_tls -ssl_dist_optfile /tmp/inet_tls.conf"
fi

# Set a default Erlang cookie value if not provided by ENV VAR.
# This default is temporary; update it using AWS secrets and config provider.
#
# Written as `if`/`fi` rather than `[ -z ... ] && export ...`: when the
# condition is false and this is the last command this file (sourced with
# `.` into a script running under `set -e`) executes, the whole boot
# script exits right here with no output - because, as the last command
# executed, its non-zero status now counts for errexit even though it's
# the left side of an `&&`. The `if` form's own exit status doesn't carry
# the test's, so it isn't fatal under -e either way.
if [ -z "${RELEASE_COOKIE}" ]; then
  export RELEASE_COOKIE="cookie"
fi
if [ -z "${RELEASE_DISTRIBUTION}" ]; then
  export RELEASE_DISTRIBUTION=sname
fi